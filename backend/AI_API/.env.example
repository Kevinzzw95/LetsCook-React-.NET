# Required by Chef Bot
OPENAI_API_KEY=replace-with-your-openai-api-key
RECIPE_DATABASE_URL=postgresql://postgres:password@localhost:5432/recipe

# Comma-separated URL templates. {query} is replaced with URL-encoded search terms.
WEB_RECIPE_SEARCH_URLS=https://www.bbcgoodfood.com/search?q={query}
WEB_RECIPE_SEARCH_MAX_RESULTS=3

# Must exactly match backend/MAIN_API's JWT_SECRET value.
JWT_SECRET=replace-with-the-main-api-jwt-signing-key

# Redis is an optional recent-message cache. PostgreSQL remains authoritative.
REDIS_URL=redis://localhost:6379/0
CHAT_HISTORY_LIMIT=40
CHAT_HISTORY_TTL_SECONDS=604800
