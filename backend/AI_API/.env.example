# Required by Chef Bot
OPENAI_API_KEY=replace-with-your-openai-api-key
RECIPE_DATABASE_URL=postgresql://postgres:password@localhost:5432/recipe

# Must exactly match backend/API's JWTSettings:TokenKey value.
JWT_SECRET=replace-with-the-dotnet-jwt-signing-key

# Redis is an optional recent-message cache. PostgreSQL remains authoritative.
REDIS_URL=redis://localhost:6379/0
CHAT_HISTORY_LIMIT=40
CHAT_HISTORY_TTL_SECONDS=604800
