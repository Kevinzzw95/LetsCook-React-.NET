# Copy to .env.docker. Use URL-safe values (e.g. openssl rand -hex 24) for DB credentials.
POSTGRES_DB=letscook
POSTGRES_USER=letscook
POSTGRES_PASSWORD=replace-with-random-hex
JWT_SECRET=replace-with-a-long-random-secret
FRONTEND_ORIGINS=http://localhost:3000
BASELINE_RESTORED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
RECIPE_VECTOR_COLLECTION=letscook_recipes
API_KEY_GEMINI=
TAVILY_API_KEY=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
USDA_API_KEY=
MEAL_PLAN_TIMEZONE=America/Toronto
# Core image intentionally excludes browser dependencies.
ENABLE_CRAWLER=false
